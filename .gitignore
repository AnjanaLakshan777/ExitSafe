.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.streamlit/secrets.toml
.env
.DS_Store

# Raw and processed data stay local (external datasets, downloads, generated
# reports). Only the folder structure (.gitkeep) is tracked. Small fixtures
# belong in data/sample/.
data/raw/**
data/processed/**
!data/raw/**/
!data/processed/**/
!data/**/.gitkeep

# Large data formats anywhere else in the repo
*.parquet
*.feather
*.h5
*.zip
*.gz
