# ExitSafe market-threat bot settings.
# Copy this file to .env (which git ignores) and fill in your values.

# --- Gemini (free key: https://aistudio.google.com/apikey) ---
# Used for web search of threat news, and for prices of symbols CSE doesn't list.
GEMINI_API_KEY=
# Defaults to gemini-flash-latest (Google's alias for the current stable Flash model).
# Pin a version only if you need to, e.g. GEMINI_MODEL=gemini-3.8-flash
# GEMINI_MODEL=gemini-flash-latest
# USE_WEB_SEARCH=true

# --- Email alerts ---
# Gmail: turn on 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# One or more addresses, comma separated
ALERT_EMAIL_TO=

# --- Threat scanning ---
# Email threats at this level or above: LOW, MEDIUM, HIGH or CRITICAL
ALERT_MIN_SEVERITY=HIGH
BOT_INTERVAL_MINUTES=30
LOOKBACK_HOURS=24

# --- Daily price updates ---
# Tracked market data (uploaded from the dashboard) is stored in the database below and
# updated by `python -m app.intelligence.bot` or `python -m app.scheduler.update_market_data`
# (see docs/TRACKED_MARKET_DATA.md).
# Older single-file setup: the bot also updates this CSV if it exists.
# Defaults to data/processed/cse/tracked_market_data.csv
# TRACKED_CSV_PATH=
# Only needed if your CSV has no Symbol column
# TRACKED_SYMBOL=JKH.N0000
# Price sources in order: cse (official), gemini (fallback for symbols CSE doesn't list)
PRICE_SOURCES=cse,gemini

# --- Client database (PostgreSQL) ---
# Create it with: python scripts/init_client_db.py
# The short keys dbname / user / password also work.
DB_NAME=exitsafe
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
